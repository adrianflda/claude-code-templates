#!/bin/sh
# gh wrapper: picks the GitHub account by the folder the command runs in.
#
# Rules come from ~/.config/gh-wrapper.conf (or $GH_WRAPPER_CONF), one per line:
#     default <account>            the account for all work not matched below
#     dir <account> <folder>       the account inside that folder (the first match wins)
# Lines that start with # are ignored. With no file, or no rule that applies, it is plain gh.
#
# The active account in `gh auth status` is never changed: the chosen account's stored token is
# passed to that one command through GH_TOKEN. The file is read as data, never executed.
# The real binary is ~/bin/gh-real. To undo: mv ~/bin/gh-real ~/bin/gh
real="$HOME/bin/gh-real"
conf="${GH_WRAPPER_CONF:-$HOME/.config/gh-wrapper.conf}"

# An explicit token, or managing accounts, is the caller's decision.
if [ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ] || [ "${1:-}" = auth ] || [ ! -r "$conf" ]; then
  exec "$real" "$@"
fi

here="$(pwd -P)/"
user=
fallback=
while read -r kind account folder || [ -n "$kind" ]; do
  case "$kind" in
    default) [ -n "$fallback" ] || fallback="$account" ;;
    dir)
      if [ -z "$user" ] && [ -n "$folder" ]; then
        case "$here" in "${folder%/}"/*) user="$account" ;; esac
      fi ;;
  esac
done < "$conf"
[ -n "$user" ] || user="$fallback"

if [ -n "$user" ]; then
  token=$("$real" auth token --user "$user" 2>/dev/null) || token=
  if [ -n "$token" ]; then
    GH_TOKEN="$token" exec "$real" "$@"
  fi
  echo "gh wrapper: no stored token for $user (gh auth login); using the active account" >&2
fi
exec "$real" "$@"
