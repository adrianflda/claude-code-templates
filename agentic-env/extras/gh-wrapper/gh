#!/bin/sh
# gh wrapper: uses the personal GitHub account inside personal work, and leaves gh alone elsewhere.
# Personal work = the current folder is under $GH_PERSONAL_DIR, or the repo's origin belongs to
# $GH_PERSONAL_USER (or uses the github-personal SSH alias). The active account in `gh auth status`
# is never changed: the personal token is passed to that one command through GH_TOKEN.
# The real binary is ~/bin/gh-real. To undo: mv ~/bin/gh-real ~/bin/gh
real="$HOME/bin/gh-real"
user="${GH_PERSONAL_USER:-adrianflda}"
dir="${GH_PERSONAL_DIR:-$HOME/Projects/personal}"

# An explicit token, or managing accounts, is the caller's decision.
if [ -n "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ] || [ "${1:-}" = auth ]; then
  exec "$real" "$@"
fi

personal=
case "$(pwd -P)/" in "$dir"/*) personal=1 ;; esac
if [ -z "$personal" ]; then
  case "$(git remote get-url origin 2>/dev/null)" in
    *github-personal:*|*[:/]"$user"/*) personal=1 ;;
  esac
fi

if [ -n "$personal" ]; then
  token=$("$real" auth token --user "$user" 2>/dev/null) || token=
  if [ -n "$token" ]; then
    GH_TOKEN="$token" exec "$real" "$@"
  fi
  echo "gh wrapper: no stored token for $user (gh auth login); using the active account" >&2
fi
exec "$real" "$@"
